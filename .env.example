# ==========================================================
# 🦅 AI-Freelance-Hunter - Modèle de Configuration (.env.example)
# ==========================================================
# Copiez ce fichier vers .env et personnalisez vos valeurs.

# ----------------------------------------------------------
# 1. NOTIFICATIONS TELEGRAM (Temps Réel)
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
MIN_NOTIFICATION_SCORE=75
TELEGRAM_RATE_LIMIT_DELAY=2.0
TELEGRAM_TIMEOUT_SECONDS=15
TELEGRAM_MAX_RETRIES=5

# ----------------------------------------------------------
# 2. SCHÉDULING & CADENCE REAL-TIME
# ----------------------------------------------------------
CRAWL_INTERVAL_MINUTES=2
JITTER_SECONDS=15
REALTIME_MODE=true
RECOVERY_ON_STARTUP=true
DOWNTIME_THRESHOLD_MINUTES=15
MAX_MISSED_WINDOW_HOURS=72
SOURCE_COOLDOWN_MINUTES=10
HEALTHCHECK_INTERVAL_MINUTES=60

# ----------------------------------------------------------
# 3. FILTRAGE DE FRAÎCHEUR & REJET DES ANCIENNES OFFRES
# ----------------------------------------------------------
FRESHNESS_MAX_AGE_HOURS=24.0
FRESHNESS_REJECT_EXPIRED=true
FRESHNESS_REALTIME_WINDOW_HOURS=2.0
FRESHNESS_REALTIME_BONUS_POINTS=15

# ----------------------------------------------------------
# 4. SYSTÈME & LOGS
# ----------------------------------------------------------
APP_NAME=AI-Freelance-Hunter
LOG_LEVEL=INFO
ENVIRONMENT=production

# ----------------------------------------------------------
# 5. PARAMÈTRES RÉSEAU & SCRAPING (HTTPX)
# ----------------------------------------------------------
NETWORK_TIMEOUT_SECONDS=20
NETWORK_MAX_RETRIES=3
NETWORK_BACKOFF_FACTOR=2.0
NETWORK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36 AI-Freelance-Hunter/1.0

# ----------------------------------------------------------
# 6. PERSISTANCE & CHEMINS DU FILESYSTEM
# ----------------------------------------------------------
DATA_DIR=data
LOGS_DIR=logs
OPPORTUNITIES_FILE=data/opportunities.jsonl
SEEN_URLS_FILE=data/seen_urls.json
FINGERPRINTS_FILE=data/fingerprints.json
NOTIFICATIONS_FILE=data/notifications.json
SOURCES_FILE=data/sources.json
CRAWL_STATE_FILE=data/crawl_state.json
RECOVERY_STATE_FILE=data/recovery_state.json
SOURCE_HEALTH_FILE=data/source_health.json
RUNS_DIR=data/runs

# ----------------------------------------------------------
# 7. SEUILS & POIDS DE SCORING
# ----------------------------------------------------------
SCORE_EXCELLENT_MIN=90
SCORE_STRONG_MIN=75
SCORE_RELEVANT_MIN=60
SCORE_IGNORE_BELOW=60

BONUS_AI=25
BONUS_WEB=20
BONUS_HYBRID=20
BONUS_PYTHON_DATA=20
BONUS_SQL_PLSQL=15
BONUS_JUNIOR=20
BONUS_REMOTE=15
BONUS_FREELANCE=15
BONUS_SKILL_OVERLAP=15
BONUS_STARTUP_SME=10

PENALTY_SENIOR=-30
PENALTY_EXPERT=-35
PENALTY_ONSITE=-30
PENALTY_UNRELATED=-50
PENALTY_R_ONLY=-50

# ----------------------------------------------------------
# 8. SÉLECTION DE LANGUES & VALIDATION STRICTE D'URLS
# ----------------------------------------------------------
ALLOWED_LANGUAGES=en,fr
REJECT_OTHER_LANGUAGES=true
VALIDATE_URLS_ONLINE=true
URL_VALIDATION_TIMEOUT_SECONDS=5.0
URL_CACHE_TTL_SECONDS=3600.0
REJECT_INVALID_URLS=true

# ----------------------------------------------------------
# 9. RECHERCHE WEB DYNAMIQUE (GOOGLE NEWS / WEB SEARCH)
# ----------------------------------------------------------
WEB_SEARCH_QUERIES=freelance developpeur react tunisie;recrutement developpeur web junior tunisie;stage pfe developpeur full stack tunisie;junior full stack developer remote freelance;junior ai agent engineer remote;remote junior react python developer;junior pl/sql developer remote;sql developer junior remote freelance;pl/sql engineer remote freelance;junior python data engineer remote;python data analyst junior remote;developpeur pl/sql oracle tunisie;data engineer python sql junior freelance
WEB_SEARCH_MAX_QUERIES=6
WEB_SEARCH_MAX_ITEMS_PER_QUERY=8


